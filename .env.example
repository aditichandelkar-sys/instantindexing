# Index Metrix — Next.js Production Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: Set these under Project Settings > Environment Variables.

# Canonical Application URL
NEXT_PUBLIC_SITE_URL=https://indexmetrixx.vercel.app

# Google Cloud OAuth 2.0 Credentials
# Registered in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirect URI (Must match registered Authorized Redirect URI in Google Cloud Console)
# Production: https://indexmetrixx.vercel.app/auth/google/callback
# Local Dev:   http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=https://indexmetrixx.vercel.app/auth/google/callback

# Session Encryption Secret (32+ character random string for AES-256 session encryption & CSRF state validation)
APP_SECRET=index_metrix_super_secure_random_key_change_me_in_production
